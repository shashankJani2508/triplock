# Copy to .env.local for local development against Supabase.
# Leave everything unset to use the built-in local file store (.data/triplock.json).

# Supabase project URL (Supabase → Project Settings → API)
SUPABASE_URL=
# Server-only key that bypasses Row Level Security. Never expose it to the browser.
# Either the legacy "service_role" key or a newer "secret" key works here.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: a Postgres connection string. When set, `npm run build` applies
# supabase/schema.sql automatically before building (first match wins).
# POSTGRES_URL_NON_POOLING=
# POSTGRES_URL=
# DATABASE_URL=
