# Copy to .env.local for local development against a real database.
# Leave everything unset to use the built-in local file store (.data/triplock.json).

# Option 1: Neon or any Postgres (first match wins)
# DATABASE_URL=postgres://user:password@host/db?sslmode=require
# POSTGRES_URL=
# Optional direct (unpooled) connection, preferred for applying the schema:
# DATABASE_URL_UNPOOLED=

# Option 2: Supabase (takes priority when both are set)
# SUPABASE_URL=https://your-project.supabase.co
# Server-only key that bypasses Row Level Security. Never expose it to the browser.
# SUPABASE_SERVICE_ROLE_KEY=
